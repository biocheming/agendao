{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agendao.dev/schemas/agendao_config.schema.json",
  "title": "AgenDao configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "theme": { "type": "string" },
    "keybinds": { "$ref": "#/$defs/keybinds" },
    "logLevel": { "type": "string" },
    "tui": { "$ref": "#/$defs/tui" },
    "server": { "$ref": "#/$defs/server" },
    "command": { "$ref": "#/$defs/commands" },
    "skills": { "$ref": "#/$defs/skills" },
    "docs": { "$ref": "#/$defs/docs" },
    "taskCategoryPath": { "type": "string" },
    "skill_paths": { "$ref": "#/$defs/stringMap" },
    "watcher": { "$ref": "#/$defs/watcher" },
    "plugin": { "$ref": "#/$defs/plugins" },
    "plugin_paths": { "$ref": "#/$defs/stringMap" },
    "toolImports": { "$ref": "#/$defs/stringArray" },
    "snapshot": { "type": "boolean" },
    "share": { "enum": ["manual", "auto", "disabled"] },
    "autoupdate": { "oneOf": [{ "type": "boolean" }, { "type": "string" }] },
    "disabled_providers": { "$ref": "#/$defs/stringArray" },
    "enabled_providers": { "$ref": "#/$defs/stringArray" },
    "disabled_tools": { "$ref": "#/$defs/stringArray" },
    "disabled_plugins": { "$ref": "#/$defs/stringArray" },
    "model": { "type": "string" },
    "small_model": { "type": "string" },
    "default_agent": { "type": "string" },
    "username": { "type": "string" },
    "agent": { "$ref": "#/$defs/agents" },
    "provider": { "$ref": "#/$defs/providers" },
    "mcp": { "$ref": "#/$defs/mcpServers" },
    "formatter": { "$ref": "#/$defs/formatter" },
    "lsp": { "$ref": "#/$defs/lsp" },
    "instructions": { "$ref": "#/$defs/stringArray" },
    "layout": { "enum": ["auto", "stretch"] },
    "uiPreferences": { "$ref": "#/$defs/uiPreferences" },
    "permission": { "$ref": "#/$defs/permission" },
    "webSearch": { "$ref": "#/$defs/webSearch" },
    "multimodal": { "$ref": "#/$defs/multimodal" },
    "externalAdapter": { "$ref": "#/$defs/externalAdapter" },
    "enterprise": { "$ref": "#/$defs/enterprise" },
    "compaction": { "$ref": "#/$defs/compaction" },
    "repairPolicy": { "enum": ["permissive", "strict"] },
    "experimental": { "$ref": "#/$defs/experimental" },
    "env": { "$ref": "#/$defs/stringMap" },
    "runtimeBudget": { "$ref": "#/$defs/runtimeBudget" }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "jsonMap": {
      "type": "object",
      "additionalProperties": true
    },
    "keybinds": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "leader", "app_exit", "editor_open", "theme_list", "sidebar_toggle",
          "scrollbar_toggle", "username_toggle", "status_view", "session_export",
          "session_new", "session_list", "session_timeline", "session_fork",
          "session_rename", "session_delete", "stash_delete", "model_provider_list",
          "model_favorite_toggle", "session_share", "session_unshare",
          "session_interrupt", "session_compact", "messages_page_up",
          "messages_page_down", "messages_line_up", "messages_line_down",
          "messages_half_page_up", "messages_half_page_down", "messages_first",
          "messages_last", "messages_next", "messages_previous", "messages_last_user",
          "messages_copy", "messages_undo", "messages_redo", "messages_toggle_conceal",
          "tool_details", "model_list", "model_cycle_recent",
          "model_cycle_recent_reverse", "model_cycle_favorite",
          "model_cycle_favorite_reverse", "command_list", "agent_list", "agent_cycle",
          "agent_cycle_reverse", "variant_cycle", "input_clear", "input_paste",
          "input_submit", "input_newline", "input_move_left", "input_move_right",
          "input_move_up", "input_move_down", "input_select_left", "input_select_right",
          "input_select_up", "input_select_down", "input_line_home", "input_line_end",
          "input_select_line_home", "input_select_line_end", "input_visual_line_home",
          "input_visual_line_end", "input_select_visual_line_home",
          "input_select_visual_line_end", "input_buffer_home", "input_buffer_end",
          "input_select_buffer_home", "input_select_buffer_end", "input_delete_line",
          "input_delete_to_line_end", "input_delete_to_line_start", "input_backspace",
          "input_delete", "input_undo", "input_redo", "input_word_forward",
          "input_word_backward", "input_select_word_forward", "input_select_word_backward",
          "input_delete_word_forward", "input_delete_word_backward", "history_previous",
          "history_next", "session_attached_focus", "session_workspace_focus",
          "session_attached_open", "session_parent", "terminal_suspend",
          "terminal_title_toggle", "tips_toggle", "display_thinking"
        ]
      },
      "additionalProperties": { "type": "string" }
    },
    "tui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string" },
        "sidebar": { "type": "boolean" },
        "scroll_speed": { "type": "number" },
        "scroll_acceleration": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } },
          "required": ["enabled"]
        },
        "diff_style": { "type": "string" }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "hostname": { "type": "string" },
        "mdns": { "type": "boolean" },
        "mdnsDomain": { "type": "string" },
        "cors": { "$ref": "#/$defs/stringArray" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/command" }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "template": { "type": "string" },
        "model": { "type": "string" },
        "agent": { "type": "string" }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": { "$ref": "#/$defs/stringArray" },
        "urls": { "$ref": "#/$defs/stringArray" },
        "disabled": { "$ref": "#/$defs/stringArray" },
        "hub": { "$ref": "#/$defs/skillHub" }
      }
    },
    "skillHub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactCacheRetentionSeconds": { "type": "integer", "minimum": 0 },
        "fetchTimeoutMs": { "type": "integer", "minimum": 0 },
        "maxDownloadBytes": { "type": "integer", "minimum": 0 },
        "maxExtractBytes": { "type": "integer", "minimum": 0 },
        "defaultRegistries": {
          "type": "array",
          "items": { "$ref": "#/$defs/skillRegistrySource" }
        },
        "indexFreshnessMaxAgeSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "skillRegistrySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "locator"],
      "properties": {
        "sourceId": { "type": "string" },
        "sourceKind": {
          "enum": ["Bundled", "LocalPath", "Git", "Archive", "Registry"]
        },
        "locator": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "contextDocsRegistryPath": { "type": "string" } }
    },
    "watcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "ignore": { "$ref": "#/$defs/stringArray" } }
    },
    "plugins": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/plugin" }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["npm", "file", "dylib"] },
        "package": { "type": "string" },
        "version": { "type": "string" },
        "path": { "type": "string" },
        "runtime": { "type": "string" },
        "options": { "$ref": "#/$defs/jsonMap" }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/agent" }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "model": { "type": "string" },
        "variant": { "type": "string" },
        "temperature": { "type": "number" },
        "top_p": { "type": "number" },
        "prompt": { "type": "string" },
        "disable": { "type": "boolean" },
        "description": { "type": "string" },
        "mode": { "enum": ["primary", "subagent", "all"] },
        "hidden": { "type": "boolean" },
        "options": { "$ref": "#/$defs/jsonMap" },
        "color": { "type": "string" },
        "steps": { "type": "integer", "minimum": 0 },
        "max_steps": { "type": "integer", "minimum": 0 },
        "max_tokens": { "type": "integer", "minimum": 0 },
        "permission": { "$ref": "#/$defs/permission" },
        "tools": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/provider" }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "id": { "type": "string" },
        "api_key": { "type": "string" },
        "base_url": { "type": "string" },
        "models": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/model" }
        },
        "options": { "$ref": "#/$defs/jsonMap" },
        "npm": {
          "enum": ["@ai-sdk/openai", "@ai-sdk/openai-compatible", "@ai-sdk/anthropic"]
        },
        "api_style": {
          "enum": ["openai-responses", "openai-compatible", "anthropic-compatible"]
        },
        "api_shape": { "type": "string" },
        "transport": { "type": "string" },
        "usage_shape": { "type": "string" },
        "quirks": { "$ref": "#/$defs/stringArray" },
        "env": { "$ref": "#/$defs/stringArray" },
        "whitelist": { "$ref": "#/$defs/stringArray" },
        "blacklist": { "$ref": "#/$defs/stringArray" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "model": { "type": "string" },
        "base_url": { "type": "string" },
        "variants": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/modelVariant" }
        },
        "tool_call": { "type": "boolean" },
        "modalities": { "$ref": "#/$defs/modelModalities" },
        "reasoning": { "type": "boolean" },
        "reasoning_effort": {
          "type": "string",
          "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "timeout_secs": { "type": "integer", "minimum": 0 },
        "stream_stall_timeout_secs": { "type": "integer", "minimum": 0 },
        "attachment": { "type": "boolean" },
        "temperature": { "type": "boolean" },
        "interleaved": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["field"],
              "properties": { "field": { "type": "string" } }
            }
          ]
        },
        "options": { "$ref": "#/$defs/jsonMap" },
        "cost": { "$ref": "#/$defs/modelCost" },
        "limit": { "$ref": "#/$defs/modelLimit" },
        "headers": { "$ref": "#/$defs/stringMap" },
        "family": { "type": "string" },
        "status": { "type": "string" },
        "release_date": { "type": "string" },
        "experimental": { "type": "boolean" },
        "provider": { "$ref": "#/$defs/modelProvider" }
      }
    },
    "modelVariant": {
      "type": "object",
      "properties": { "disabled": { "type": "boolean" } },
      "additionalProperties": true
    },
    "modelModalities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": { "$ref": "#/$defs/stringArray" },
        "output": { "$ref": "#/$defs/stringArray" }
      }
    },
    "modelCost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": { "type": "number" },
        "output": { "type": "number" },
        "cache_read": { "type": "number" },
        "cache_write": { "type": "number" },
        "context_over_200k": { "$ref": "#/$defs/modelCost" }
      }
    },
    "modelLimit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context": { "type": "integer", "minimum": 0 },
        "input": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 }
      }
    },
    "modelProvider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "npm": { "type": "string" },
        "api": { "type": "string" }
      }
    },
    "mcpServers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/mcpServerEntry" }
    },
    "mcpServerEntry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        },
        { "$ref": "#/$defs/mcpServer" }
      ]
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "command": { "$ref": "#/$defs/stringArray" },
        "environment": { "$ref": "#/$defs/stringMap" },
        "url": { "type": "string" },
        "enabled": { "type": "boolean" },
        "timeout": { "type": "integer", "minimum": 0 },
        "headers": { "$ref": "#/$defs/stringMap" },
        "oauth": {
          "oneOf": [
            { "const": false },
            { "$ref": "#/$defs/mcpOAuth" }
          ]
        }
      }
    },
    "mcpOAuth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientId": { "type": "string" },
        "authorizationUrl": { "type": "string" },
        "clientSecret": { "type": "string" },
        "scope": { "type": "string" }
      }
    },
    "formatter": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/formatterEntry" }
        }
      ]
    },
    "formatterEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disabled": { "type": "boolean" },
        "command": { "$ref": "#/$defs/stringArray" },
        "environment": { "$ref": "#/$defs/stringMap" },
        "extensions": { "$ref": "#/$defs/stringArray" }
      }
    },
    "lsp": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/lspServer" }
        }
      ]
    },
    "lspServer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": { "$ref": "#/$defs/stringArray" },
        "extensions": { "$ref": "#/$defs/stringArray" },
        "disabled": { "type": "boolean" },
        "env": { "$ref": "#/$defs/stringMap" },
        "initialization": { "$ref": "#/$defs/jsonMap" }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/permissionAction" },
          {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/permissionAction" }
          }
        ]
      }
    },
    "permissionAction": { "enum": ["ask", "allow", "deny"] },
    "uiPreferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": { "type": "string" },
        "webTheme": { "type": "string" },
        "webMode": { "type": "string" },
        "showHeader": { "type": "boolean" },
        "showScrollbar": { "type": "boolean" },
        "tipsHidden": { "type": "boolean" },
        "showTimestamps": { "type": "boolean" },
        "showThinking": { "type": "boolean" },
        "showToolDetails": { "type": "boolean" },
        "messageDensity": { "type": "string" },
        "semanticHighlight": { "type": "boolean" }
      }
    },
    "webSearch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_url": { "type": "string" },
        "endpoint": { "type": "string" },
        "method": { "type": "string" },
        "defaultSearchType": { "type": "string" },
        "defaultNumResults": { "type": "integer", "minimum": 0 },
        "options": { "$ref": "#/$defs/jsonMap" }
      }
    },
    "multimodal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "voice": { "$ref": "#/$defs/voice" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxInputBytes": { "type": "integer", "minimum": 0 },
            "maxAttachmentsPerPrompt": { "type": "integer", "minimum": 0 }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowAudioInput": { "type": "boolean" },
            "allowImageInput": { "type": "boolean" },
            "allowFileInput": { "type": "boolean" }
          }
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationSeconds": { "type": "integer", "minimum": 0 },
        "attachAudio": { "type": "boolean" },
        "mime": { "type": "string" },
        "language": { "type": "string" },
        "record": { "$ref": "#/$defs/voiceCommand" },
        "transcribe": { "$ref": "#/$defs/voiceCommand" }
      }
    },
    "voiceCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": { "$ref": "#/$defs/stringArray" },
        "env": { "$ref": "#/$defs/stringMap" }
      }
    },
    "externalAdapter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapters": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/externalAdapterEntry" }
        },
        "replay": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "retentionSeconds": { "type": "integer", "minimum": 0 },
            "nonceWindowSeconds": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "externalAdapterEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "source": { "type": "string" },
        "secretRef": { "type": "string" },
        "defaultWorkspace": { "type": "string" },
        "routePolicyId": { "type": "string" },
        "allowSessionRun": { "type": "boolean" },
        "allowedWorkspaces": { "$ref": "#/$defs/stringArray" }
      }
    },
    "enterprise": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "managed_config_dir": { "type": "string" }
      }
    },
    "compaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auto": { "type": "boolean" },
        "prune": { "type": "boolean" },
        "reserved": { "type": "integer", "minimum": 0 }
      }
    },
    "experimental": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disable_paste_summary": { "type": "boolean" },
        "batch_tool": { "type": "boolean" },
        "open_telemetry": { "type": "boolean" },
        "primary_tools": { "$ref": "#/$defs/stringArray" },
        "continue_loop_on_deny": { "type": "boolean" },
        "mcp_timeout": { "type": "integer", "minimum": 0 }
      }
    },
    "runtimeBudget": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "enum": [
          "tool_result_max_chars", "tool_result_preview_chars",
          "tool_batch_aggregate_max_chars", "max_tool_result_transcript_chars",
          "max_attachment_bytes", "max_mcp_resource_chars",
          "stream_connection_queue_size", "max_ui_bridge_queue", "max_events_per_frame",
          "frontend_max_prompt_history_entries", "frontend_max_stash_entries",
          "frontend_max_frecency_entries", "frontend_max_transcript_lines",
          "frontend_semantic_highlight_max_chars",
          "frontend_max_tool_result_display_chars", "tui_max_viewport_messages",
          "tui_message_output_cache_entries", "tui_max_render_ops_per_frame",
          "web_max_pending_output_blocks", "web_side_panel_cache_entries",
          "pty_buffer_limit"
        ]
      },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
